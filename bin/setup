#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "openssl"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "========================================================"
  puts "  User Service - Local Setup"
  puts "========================================================"

  # 1. Pre-flight Check: Verify mise is installed upfront (Fail-Fast / Atomic)
  puts "\n== 1. Checking Prerequisites (mise) =="
  unless system("which mise > /dev/null 2>&1")
    abort <<~MSG
      Error: 'mise' is required for local non-Docker development.
      Please install mise (https://mise.jdx.dev) and run bin/setup again:
        curl https://mise.run | sh
    MSG
  end
  puts "✓ mise is installed"

  # 2. Sync Toolchain via mise
  puts "\n== 2. Installing Toolchain via mise =="
  system!("mise install")

  # 3. Ensure .env exists from .env.example
  puts "\n== 3. Preparing Environment Configuration =="
  unless File.exist?(".env")
    puts "Creating .env from .env.example..."
    FileUtils.cp(".env.example", ".env")
  end

  # 4. Ensure JWT_PRIVATE_KEY is configured in .env
  env_content = File.read(".env")
  unless env_content.match?(/^JWT_PRIVATE_KEY=/)
    puts "Generating 2048-bit RSA key for RS256 JWT auth..."
    rsa = OpenSSL::PKey::RSA.generate(2048)
    escaped_pem = rsa.to_pem.gsub("\n", '\n')
    File.open(".env", "a") do |f|
      f.puts "\n# Auto-generated development RS256 private key"
      f.puts "JWT_PRIVATE_KEY=\"#{escaped_pem}\""
    end
    puts "✓ Saved persistent JWT_PRIVATE_KEY into .env"
  end

  # 5. Install Backend Ruby Gems
  puts "\n== 4. Installing Backend Ruby Gems =="
  system("bundle check") || system!("bundle install")

  # 6. Install Frontend Node/Bun Dependencies
  puts "\n== 5. Installing Frontend Dependencies =="
  FileUtils.chdir "client" do
    if system("which bun > /dev/null 2>&1")
      system!("bun install")
    elsif system("which npm > /dev/null 2>&1")
      system!("npm install")
    end
  end

  # 7. Database Preparation & Seed
  puts "\n== 6. Preparing Database & Seeds =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:seed"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  # 8. Clean logs and tempfiles
  puts "\n== 7. Removing Old Logs and Tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n========================================================"
  puts "✓ Local Setup Complete!"
  puts "========================================================"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush
    exec "bin/dev"
  end
end
